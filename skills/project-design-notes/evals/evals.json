{
  "skill_name": "project-design-notes",
  "evals": [
    {
      "id": 1,
      "prompt": "为导出流式化创建 MVP 设计记录。",
      "expected_output": "中文、证据驱动的报告或产物，明确未验证事项和下一步。",
      "files": [
        "evals/files/proposed.md"
      ],
      "expectations": [
        "保留 proposed 状态",
        "包含 Problem、Proposal、Alternatives、Acceptance criteria、Risks",
        "明确当前未实现"
      ]
    },
    {
      "id": 2,
      "prompt": "根据实现 diff 将提案收敛为 implemented。",
      "expected_output": "中文、证据驱动的报告或产物，明确未验证事项和下一步。",
      "files": [
        "evals/files/proposed.md",
        "evals/files/implementation.md"
      ],
      "expectations": [
        "要求同变更改写 Decision",
        "同步 subsystem/package owner",
        "列出偏差和验证"
      ]
    },
    {
      "id": 3,
      "prompt": "新方案替代一部分旧决策，且归档记录存在。",
      "expected_output": "中文、证据驱动的报告或产物，明确未验证事项和下一步。",
      "files": [
        "evals/files/proposed.md"
      ],
      "expectations": [
        "区分完整和部分替代",
        "不把 archived 当当前事实",
        "生成双向替代关系"
      ]
    }
  ]
}
